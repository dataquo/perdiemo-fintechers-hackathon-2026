# =================================================================
# PerDiemo Copilot — AWS & Hackathon Environment Configuration
# =================================================================

# AWS Region & Profile Configuration
# Work lives in Frankfurt (eu-central-1); Sign-in SSO lives in Stockholm (eu-north-1)
AWS_REGION=eu-central-1
AWS_DEFAULT_REGION=eu-central-1
AWS_PROFILE=hackathon

# Bedrock Model Configuration (Must use 'eu.' prefix for EU cross-region inference)
# Claude Sonnet 4.5: eu.anthropic.claude-sonnet-4-5-20250929-v1:0 (recommended for extraction accuracy)
# Claude Haiku 4.5:  eu.anthropic.claude-haiku-4-5-20251001-v1:0 (recommended for high volume / drafting)
# Claude Opus 4.5:   eu.anthropic.claude-opus-4-5-20251101-v1:0 (complex multi-step reasoning)
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0

# Temporary Session Credentials (Optional fallback if not using 'aws sso login')
# Obtained from the Access Portal (https://d-c3676ff6eb.awsapps.com/start) -> Access keys
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Shared Hackathon Datasets S3 Bucket (read-only)
DATASETS_S3_URI=s3://ai-hackathon-datasets-422928733782/

# PerDiemo Cloud Engine API URL (Production Live Backend)
PERDIEMO_API_URL=https://perdiemo-backend-production.onrender.com
