# =================================================================
# PerDiemo Copilot — Environment Configuration Template
# =================================================================

# AWS Bedrock Configuration (provided during Day 1 AWS Toolbox)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your_hackathon_access_key_here
AWS_SECRET_ACCESS_KEY=your_hackathon_secret_key_here
AWS_SESSION_TOKEN=optional_session_token_if_using_temporary_credentials

# Bedrock Model ID (default: Claude 3.5 Sonnet v2)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# PerDiemo Cloud Engine API URL (Production Live Backend)
PERDIEMO_API_URL=https://perdiemo-backend-production.onrender.com
