# PERDIEMO MCP v0.2
# Modes are EXPLICIT; default (unset) is disabled, not mock/live.
# Prefer launching via ./start.sh mock|live|staging <url> (this file is NOT loaded automatically).
PERDIEMO_API_MODE=mock

# Mode=live: set the API endpoint and, if it is the production Render host,
# explicitly set PERDIEMO_ALLOW_PRODUCTION=true.
# NOTE: no customer/employee/transaction data should be sent to production for tests.
# PERDIEMO_API_MODE=live
# PERDIEMO_API_URL=https://perdiemo-backend-production.onrender.com
# PERDIEMO_ALLOW_PRODUCTION=true

# Optional MCP listener controls (localhost by default, never internet-exposed):
# PERDIEMO_MCP_HOST=127.0.0.1
# PERDIEMO_MCP_PORT=8001
# PERDIEMO_MCP_TRANSPORT=streamable-http
